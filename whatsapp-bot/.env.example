# WhatsApp bot settings. Copy to whatsapp-bot/.env and fill in. Never commit .env.

# Meta App Dashboard > WhatsApp > API Setup: access token and phone number ID
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you make up. Paste the same string into the Meta webhook form.
WHATSAPP_VERIFY_TOKEN=
# Optional. App settings > Basic > App secret. Turns on webhook signature checks.
META_APP_SECRET=
# Optional. Defaults to v26.0
GRAPH_API_VERSION=

# Public https base of the Fenster app (tunnel to npm start on :3000), no path
GAME_URL=
# Optional. Defaults to 5050
PORT=
# Shown in every invite and on "help": how to reach a person on the team (email or phone). Optional.
TEAM_CONTACT=
